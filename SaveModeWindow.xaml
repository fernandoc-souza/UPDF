<Window x:Class="PdfToolbox.SaveModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salvar PDF assinado" Height="215" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Como deseja salvar a assinatura?"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                <Run FontWeight="SemiBold" Text="Substituir"/>
                <Run Text=" — grava a assinatura por cima do arquivo aberto."/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Gerar novo"/>
                <Run Text=" — mantém o original intacto e cria um arquivo novo."/>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Width="100" Margin="0,0,10,0" Padding="5"
                    IsCancel="True" Click="BtnCancelar_Click"/>
            <Button Content="Substituir" Width="110" Margin="0,0,10,0" Padding="5"
                    Click="BtnSubstituir_Click"/>
            <Button Content="Gerar novo" Width="110" Padding="5" IsDefault="True"
                    Background="#0078D7" Foreground="White" Click="BtnGerarNovo_Click"/>
        </StackPanel>
    </Grid>
</Window>
